# Copy to .env for local runs. NEVER commit .env.
# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New secret key (sb_secret_...) recommended; a legacy service_role JWT also works.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# --- Data ---
DATA_SOURCE=supabase            # supabase | csv
LOCAL_DATA_PATH=data/sample_sales.csv
BUSINESS_TZ=Asia/Colombo
STALE_DATA_DAYS=3
INACTIVE_SERIES_DAYS=60

# --- Modelling (CUSTOMIZE) ---
TARGET_METRIC=revenue           # revenue | profit | units
FORECAST_HORIZON=14
MAX_HORIZON=28
VALIDATION_DAYS=28
HOLIDAY_COUNTRY=LK              # python-holidays code; empty disables

# --- Promotion gate ---
MIN_IMPROVEMENT_VS_BASELINE=0.05
MAX_REGRESSION_VS_PRODUCTION=0.10
# MAX_WAPE=0.6

# --- Serving ---
MODEL_SOURCE=local              # local | supabase
MODEL_PATH=artifacts/latest/model.joblib
MODEL_CACHE_DIR=/tmp/model_cache
HISTORY_CACHE_TTL_S=300
# ADMIN_TOKEN=generate-a-long-random-string   # enables POST /admin/reload
# API_KEYS=key-for-dashboard,key-for-pos      # when set, /predict requires header X-API-Key
LOG_LEVEL=INFO
